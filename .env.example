# Root Environment Example
APP_ENV=development
MOCK_SENSORS=true
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
BACKEND_URL=http://backend-service:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_RECONNECT_ATTEMPTS=5
NEXT_PUBLIC_SENSOR_EVENT_NAME=sensor:height

# MySQL Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=baiscan_db
MYSQL_USER=baiscan_user
MYSQL_PASSWORD=baiscan_password

# Database Connection
DB_HOST=db
DB_PORT=3306
DB_USER=baiscan_user
DB_PASSWORD=baiscan_password
DB_NAME=baiscan_db

# JWT Configuration
JWT_SECRET=your_access_token_secret_32_chars_long
JWT_REFRESH_SECRET=your_refresh_token_secret_32_chars_long
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
