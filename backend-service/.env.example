# Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_USER=baiscan_user
DB_PASSWORD=baiscan_password
DB_NAME=baiscan_db

# JWT Configuration
# Generate secure 32+ character strings for these
JWT_SECRET=your_access_token_secret_32_chars_long
JWT_REFRESH_SECRET=your_refresh_token_secret_32_chars_long
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Microservices
SENSOR_SERVICE_URL=http://sensor-service:8000
